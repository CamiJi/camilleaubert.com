---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  /** Page language (site chrome is English; articles can be EN or FR) */
  lang?: 'en' | 'fr';
  /** Alternate language versions of this page for hreflang (self included separately) */
  alternates?: { lang: 'en' | 'fr'; href: string }[];
}

const currentPath = Astro.url.pathname;
const {
  title,
  description,
  image = `${site.url}/og-image.webp`,
  canonical = `${site.url}${currentPath === '/' ? '' : currentPath}`,
  lang = 'en',
  alternates = [],
} = Astro.props;

const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0b10" />

    <link rel="preload" href="/fonts/satoshi/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={`${site.name} — ${site.title}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": site.name,
        "jobTitle": "AI Solutions Architect & Lead Full-Stack Developer",
        "url": site.url,
        "sameAs": [
          "https://github.com/CamiJi",
          "https://www.linkedin.com/in/camille-aubert-27760a56/"
        ],
        "email": "mailto:aubertcam@gmail.com",
        "image": [
          `${site.url}/camille-aubert-portrait.webp`,
          {
            "@type": "ImageObject",
            "url": `${site.url}/camille-aubert-cegos-office.webp`,
            "contentUrl": `${site.url}/camille-aubert-cegos-office.webp`,
            "width": 1280,
            "height": 1600,
            "caption": "Camille Aubert at the Cegos office, wearing a headset during a technical review",
            "name": "Camille Aubert — Lead Developer & AI Solutions Architect at Cegos"
          },
          {
            "@type": "ImageObject",
            "url": `${site.url}/camille-aubert-india-motorcycle.webp`,
            "contentUrl": `${site.url}/camille-aubert-india-motorcycle.webp`,
            "width": 1600,
            "height": 1200,
            "caption": "Camille Aubert on a Royal Enfield motorcycle in the streets of Delhi, India — his travel industry years",
            "name": "Camille Aubert in India — travel industry years"
          },
          {
            "@type": "ImageObject",
            "url": `${site.url}/camille-aubert-workstation-full.webp`,
            "contentUrl": `${site.url}/camille-aubert-workstation-full.webp`,
            "width": 1200,
            "height": 1600,
            "caption": "Camille Aubert's full home workstation in Fontenay-le-Fleury — wooden desk, rattan chair and garden window, Laravel, React and AI development",
            "name": "Camille Aubert's workstation"
          }
        ],
        "alternateName": ["Camiji", "Kamos"],
        "worksFor": {
          "@type": "Organization",
          "name": "Cegos Group"
        },
        "alumniOf": [
          { "@type": "CollegeOrUniversity", "name": "Université de Bourgogne" },
          { "@type": "EducationalOrganization", "name": "Webforce3" }
        ],
        "homeLocation": {
          "@type": "Place",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Fontenay-le-Fleury",
            "addressRegion": "Île-de-France",
            "addressCountry": "FR"
          }
        },
        "knowsLanguage": ["fr", "en", "es"]
      }
    </script>

    <!-- Dates de fraîcheur pour Google (métadata reconnus) -->
    <meta property="datePublished" content="${datePublished}" />
    <meta property="dateModified" content="${dateModified}" />
  </head>

  <body class="relative min-h-screen overflow-x-hidden antialiased">
    <!-- Skip to content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-accent focus:text-white focus:rounded-lg focus:outline-none"
    >
      Skip to main content
    </a>

    <a
      href="/"
      class="fixed top-4 left-4 text-subtext hover:text-accent transition-colors text-xs font-body uppercase tracking-wider"
      aria-label="Retour à l'accueil"
    >
      Accueil
    </a>

    <main id="main-content" class="px-2 sm:px-12 md:px-14 lg:px-28 max-w-360 mx-auto relative z-0">
        <slot />
    </main>

    <button
      id="to-top"
      class="fixed bottom-8 right-8 z-50 p-0 rounded-full bg-background border border-accent/10 shadow-2xl transition-all duration-500 translate-y-20 opacity-0 group flex items-center justify-center cursor-pointer"
      aria-label="Back to top"
    >
      <svg class="w-14 h-14 -rotate-90">
        <circle cx="28" cy="28" r="24" fill="none" stroke="currentColor" stroke-width="3" class="text-accent/5"></circle>
        <circle
          id="progress-circle"
          cx="28" cy="28" r="24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-dasharray="150.7"
          stroke-dashoffset="150.7"
          stroke-linecap="round"
          class="text-accent transition-all duration-100"
        ></circle>
      </svg>

      <div class="absolute text-accent group-hover:scale-110 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M13.0001 7.82843V20H11.0001V7.82843L5.63614 13.1924L4.22192 11.7782L12.0001 4L19.7783 11.7782L18.3641 13.1924L13.0001 7.82843Z"></path>
        </svg>
      </div>
    </button>

    <script>
      import '../scripts/to-top';
    </script>

    {beaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${beaconToken}"}`}
      ></script>
    )}
  </body>
</html>
