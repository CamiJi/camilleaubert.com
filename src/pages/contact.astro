---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact — Camille Aubert"
  description="Contact Camille Aubert to discuss AI systems architecture, full-stack leadership, and next-generation intelligent platforms."
>
  <section class="section-container max-w-3xl mx-auto pt-16 md:pt-24">
    <p class="text-accent text-xs uppercase tracking-widest font-semibold font-body">Contact</p>
    <h1 class="text-4xl md:text-5xl font-heading font-bold text-maintext mt-3 leading-tight">
      Let's architect your next-generation intelligent systems together.
    </h1>
    <p class="text-subtext font-body text-lg leading-relaxed mt-6">
      If you are building ambitious digital products, scaling enterprise platforms, or exploring
      production-grade AI integration, I would be glad to connect.
    </p>
  </section>

  <section class="section-container max-w-3xl mx-auto content-section grid md:grid-cols-2 gap-6 pb-24">
    <div class="bg-accent/5 border border-accent/10 rounded-2xl p-6 md:p-8 hover:border-accent/40 transition-all">
      <h2 class="text-xl font-heading font-bold text-maintext">Get in touch</h2>
      <p class="text-subtext font-body text-sm leading-relaxed mt-3 mb-6">
        Available for strategic discussions around AI systems architecture, platform
        modernization, and high-performance full-stack delivery.
      </p>
      <ul class="space-y-3 text-sm font-body">
        <li class="flex gap-2"><span class="text-maintext font-medium shrink-0">Email:</span><a class="text-accent hover:text-maintext transition-colors" href="mailto:aubertcam@gmail.com">aubertcam@gmail.com</a></li>
        <li class="flex gap-2"><span class="text-maintext font-medium shrink-0">LinkedIn:</span><a class="text-accent hover:text-maintext transition-colors" href="https://www.linkedin.com/in/camille-aubert-27760a56/" target="_blank" rel="noreferrer">camille-aubert-27760a56</a></li>
        <li class="flex gap-2"><span class="text-maintext font-medium shrink-0">GitHub:</span><a class="text-accent hover:text-maintext transition-colors" href="https://github.com/CamiJi" target="_blank" rel="noreferrer">CamiJi</a></li>
      </ul>
    </div>

    <div class="bg-accent/5 border border-accent/10 rounded-2xl p-6 md:p-8 hover:border-accent/40 transition-all">
      <p class="text-accent text-xs uppercase tracking-widest font-semibold font-body">Collaboration</p>
      <h2 class="text-xl font-heading font-bold text-maintext mt-2">What I can help with</h2>
      <ul class="mt-4 space-y-3">
        <li class="flex gap-3 text-subtext font-body text-sm leading-relaxed">
          <span class="text-accent mt-0.5">→</span>
          Designing AI-enabled system architectures for production use.
        </li>
        <li class="flex gap-3 text-subtext font-body text-sm leading-relaxed">
          <span class="text-accent mt-0.5">→</span>
          Leading full-stack delivery for complex enterprise platforms.
        </li>
        <li class="flex gap-3 text-subtext font-body text-sm leading-relaxed">
          <span class="text-accent mt-0.5">→</span>
          Improving scalability, maintainability, and technical performance.
        </li>
      </ul>
    </div>
  </section>
</Layout>
