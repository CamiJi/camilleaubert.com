---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import profile from '../../data/profile.json';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Layout
  title="Writing — Camille Aubert"
  description="Field notes on RAG architectures, AI-assisted engineering, and running enterprise platforms — by Camille Aubert."
>
  <section class="section-container max-w-3xl mx-auto pt-16 md:pt-24">
    <p class="text-accent text-xs uppercase tracking-widest font-semibold font-body">Writing</p>
    <h1 class="text-4xl md:text-5xl font-heading font-bold text-maintext mt-3 leading-tight">
      Field notes from production.
    </h1>
    <p class="text-subtext font-body text-lg leading-relaxed mt-6">
      The longer form of what goes out on LinkedIn — RAG architectures, AI-assisted
      engineering, and platform work, written as they happen.
    </p>
    <a
      href="/rss.xml"
      class="mt-5 inline-flex items-center gap-1.5 text-subtext hover:text-accent transition-colors font-body text-xs"
      title="RSS feed"
    >
      <Icon name="mdi:rss" class="w-4 h-4" />
      Subscribe via RSS
    </a>
  </section>

  <section class="section-container max-w-3xl mx-auto content-section space-y-4 pb-24">
    {posts.map((post) => (
      <a
        href={`/writing/${post.id}/`}
        class="group block bg-accent/5 border border-accent/10 rounded-2xl p-6 md:p-8 hover:border-accent/40 hover:bg-accent/10 transition-all"
      >
        <div class="flex items-center gap-3 mb-4">
          <img
            src={profile.photoUrl}
            alt=""
            width="384"
            height="384"
            loading="lazy"
            decoding="async"
            class="w-10 h-10 rounded-full object-cover"
          />
          <div>
            <p class="text-maintext font-body text-sm font-medium leading-tight">{profile.name}</p>
            <p class="text-subtext font-body text-xs leading-tight">{fmtDate(post.data.date)}</p>
          </div>
          {post.data.linkedinUrl && (
            <span class="ml-auto text-subtext text-[10px] uppercase tracking-widest flex items-center gap-1">
              Also on LinkedIn
              <Icon name="mdi:linkedin" class="w-3.5 h-3.5" />
            </span>
          )}
        </div>
        <h2 class="text-xl md:text-2xl font-heading font-bold text-maintext group-hover:text-accent transition-colors">
          {post.data.title}
        </h2>
        <p class="text-subtext font-body text-sm md:text-base leading-relaxed mt-3">
          {post.data.excerpt}
        </p>
        <p class="text-accent font-body text-xs mt-5 flex items-center gap-1.5">
          Read the post
          <Icon name="mdi:arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
        </p>
      </a>
    ))}
    {posts.length === 0 && (
      <p class="text-subtext font-body">First field notes coming soon.</p>
    )}
  </section>
</Layout>
