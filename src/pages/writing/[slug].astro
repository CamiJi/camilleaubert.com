---
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import profile from '../../data/profile.json';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const ogImage = `${site.url}/writing/${post.id}/og.png`;

const postLang = post.data.lang ?? 'en';
const isFr = postLang === 'fr';

// Counterpart article in the other language (paired via `translationOf`)
let alternate: { lang: 'en' | 'fr'; href: string } | null = null;
if (post.data.translationOf) {
  const all = await getCollection('writing', ({ data }) => !data.draft);
  const twin = all.find((p) => p.id === post.data.translationOf);
  if (twin) {
    alternate = {
      lang: twin.data.lang ?? 'en',
      href: `${site.url}/writing/${twin.id}/`,
    };
  }
}

const alternates = [
  { lang: postLang as 'en' | 'fr', href: `${site.url}/writing/${post.id}/` },
  ...(alternate ? [alternate] : []),
];

const fmtDate = (d: Date) =>
  d.toLocaleDateString(isFr ? 'fr-FR' : 'en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const readingTime = `${Math.max(1, Math.round(post.body.split(/\s+/).length / 200))} ${isFr ? 'min de lecture' : 'min read'}`;
---

<Layout
  title={`${post.data.title} — Camille Aubert`}
  description={post.data.excerpt}
  image={ogImage}
  lang={postLang}
  alternates={alternates}
>
  <article class="section-container max-w-3xl mx-auto pt-12 md:pt-20 pb-24">
    <div class="flex items-center justify-between gap-4">
      <a href="/writing/" class="text-subtext hover:text-accent transition-colors font-body text-sm flex items-center gap-1.5">
        <Icon name="mdi:arrow-left" class="w-4 h-4" />
        {isFr ? 'Tous les articles' : 'All posts'}
      </a>
      <span class="shrink-0 text-[10px] uppercase tracking-widest font-body px-2.5 py-1 rounded-full border border-accent/30 text-accent">
        {isFr ? 'En français' : 'In English'}
      </span>
    </div>

    {alternate && (
      <a
        href={`/writing/${post.data.translationOf}/`}
        hreflang={alternate.lang}
        class="mt-4 inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/5 px-4 py-1.5 text-subtext font-body text-xs hover:text-maintext hover:border-accent/40 transition-all"
      >
        <Icon name="mdi:translate" class="w-4 h-4 text-accent" />
        {isFr ? 'Read in English' : "Lire en français"}
      </a>
    )}

    <header class="mt-8 mb-10">
      <div class="flex items-center gap-3 mb-5">
        <img
          src={profile.photoUrl}
          alt=""
          width="384"
          height="384"
          loading="lazy"
          decoding="async"
          class="w-11 h-11 rounded-full object-cover"
        />
        <div>
          <p class="text-maintext font-body text-sm font-medium leading-tight">{profile.name}</p>
          <p class="text-subtext font-body text-xs leading-tight">{fmtDate(post.data.date)} · {readingTime}</p>
        </div>
      </div>
      <h1 class="text-3xl md:text-5xl font-heading font-bold text-maintext leading-tight tracking-tight">
        {post.data.title}
      </h1>
      <p class="text-subtext font-body text-lg leading-relaxed mt-5">
        {post.data.excerpt}
      </p>
    </header>

    <div class="article-body text-subtext font-body text-base md:text-lg leading-relaxed">
      <Content />
    </div>

    <footer class="mt-14 pt-8 border-t border-accent/10">
      <div class="bg-accent/5 border border-accent/10 rounded-2xl p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <p class="text-maintext font-body text-sm font-medium">
            {post.data.linkedinUrl
              ? (isFr ? 'Sorti aussi sur LinkedIn.' : 'This went out on LinkedIn too.')
              : (isFr ? 'Cet article fait aussi partie de mon fil LinkedIn.' : 'This post is also part of my LinkedIn feed.')}
          </p>
          <p class="text-subtext font-body text-xs mt-1">{isFr ? 'Questions, réactions, contradictions — la conversation se passe là-bas.' : 'Questions, reactions, pushback — the conversation happens there.'}</p>
        </div>
        {post.data.linkedinUrl && (
          <a
            href={post.data.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 inline-flex items-center gap-2 px-5 py-2 border border-accent/50 bg-accent/10 rounded-full text-maintext font-body text-sm hover:scale-105 transition-all"
          >
            <Icon name="mdi:linkedin" class="w-4 h-4" />
            {isFr ? 'Discuter sur LinkedIn' : 'Discuss on LinkedIn'}
          </a>
        )}
      </div>
    </footer>
  </article>
</Layout>

<style>
  @reference "../../styles/global.css";

  .article-body :global(h2) {
    @apply text-maintext font-heading font-bold text-2xl md:text-3xl mt-12 mb-4 tracking-tight;
  }
  .article-body :global(h3) {
    @apply text-maintext font-heading font-bold text-xl md:text-2xl mt-10 mb-3;
  }
  .article-body :global(p) {
    @apply mb-5;
  }
  .article-body :global(ul) {
    @apply list-disc pl-6 space-y-2 mb-6;
  }
  .article-body :global(ol) {
    @apply list-decimal pl-6 space-y-2 mb-6;
  }
  .article-body :global(blockquote) {
    @apply border-l-2 border-accent/50 pl-5 py-1 my-6 text-subtext italic;
  }
  .article-body :global(code) {
    @apply text-accent bg-accent/10 rounded px-1.5 py-0.5 text-[0.9em];
  }
  .article-body :global(pre) {
    @apply bg-accent/5 border border-accent/10 rounded-xl p-4 overflow-x-auto my-6;
  }
  .article-body :global(pre code) {
    @apply bg-transparent p-0 text-subtext;
  }
  .article-body :global(a) {
    @apply text-accent hover:text-maintext underline underline-offset-4 decoration-accent/40 hover:decoration-accent transition-colors;
  }
  .article-body :global(strong) {
    @apply text-maintext font-semibold;
  }
</style>
