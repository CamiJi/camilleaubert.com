---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'Industrial RAG Infrastructure',
    category: 'AI Systems',
    context:
      'Deploying generative AI systems for mission-critical knowledge management within the Cegos Group.',
    role: 'Solution Architect & Lead Developer',
    stack: 'AWS Bedrock, OpenAI API, Python, RAG Frameworks.',
    outcome:
      'Achieved a 95% accuracy rate for business-critical data retrieval and automated decision-making.',
    link: 'https://www.cegos.fr',
  },
  {
    title: 'Cegos Enterprise Platform',
    category: 'Platform Architecture',
    context:
      "Directing the architectural evolution of the primary platform for Europe's leader in professional training.",
    role: 'Transversal Architect / Lead Developer',
    stack: 'Laravel, WordPress, Gutenberg, Docker, AWS.',
    outcome:
      'Successfully migrated to a containerized infrastructure, ensuring seamless scalability for millions of users.',
    link: 'https://www.cegos.fr',
  },
  {
    title: 'Technical Performance Lab',
    category: 'Performance & SEO',
    context:
      'Developed lamaisonmontparnasse.fr as a dedicated research lab for extreme SEO and conversion optimization.',
    role: 'Full-stack Developer & Technical SEO Specialist',
    stack: 'PHP, Custom Gutenberg Blocks, High-speed rendering.',
    outcome:
      'Delivered record-breaking performance scores and a highly optimized user acquisition funnel.',
    link: 'https://lamaisonmontparnasse.fr',
  },
];
---

<Layout
  title="Projects — Camille Aubert"
  description="Selected projects from Camille Aubert covering industrial RAG systems, enterprise platform architecture, and high-performance web delivery."
>
  <section class="section-container max-w-3xl mx-auto pt-16 md:pt-24">
    <p class="text-accent text-xs uppercase tracking-widest font-semibold font-body">Projects</p>
    <h1 class="text-4xl md:text-5xl font-heading font-bold text-maintext mt-3 leading-tight">Selected work</h1>
    <p class="text-subtext font-body text-lg leading-relaxed mt-6">
      A selection of projects focused on AI architecture, enterprise-scale platforms, and
      performance-driven web engineering.
    </p>
  </section>

  <section class="section-container max-w-3xl mx-auto content-section">
    <p class="text-subtext font-body leading-relaxed">
      My work sits at the intersection of intelligent systems, robust platform architecture, and
      operational performance. Each project below reflects a production-first approach built for
      reliability, scale, and measurable impact.
    </p>
  </section>

  <section class="section-container max-w-3xl mx-auto content-section space-y-8 pb-24">
    {projects.map((project) => (
      <div class="bg-accent/5 border border-accent/10 rounded-2xl p-6 md:p-8 hover:border-accent/40 transition-all">
        <div class="flex justify-between items-start gap-4">
          <div>
            <span class="text-accent text-[10px] uppercase tracking-widest font-bold">{project.category}</span>
            <h2 class="text-xl font-heading font-bold text-maintext mt-1">{project.title}</h2>
          </div>
          {project.link && (
            <a href={project.link} target="_blank" rel="noreferrer" class="text-subtext hover:text-accent transition-colors text-sm shrink-0">
              Visit project ↗
            </a>
          )}
        </div>
        <dl class="mt-4 space-y-2 text-sm font-body">
          <div class="flex gap-2"><dt class="text-maintext font-medium shrink-0">Context:</dt><dd class="text-subtext">{project.context}</dd></div>
          <div class="flex gap-2"><dt class="text-maintext font-medium shrink-0">Role:</dt><dd class="text-subtext">{project.role}</dd></div>
          <div class="flex gap-2"><dt class="text-maintext font-medium shrink-0">Stack:</dt><dd class="text-subtext">{project.stack}</dd></div>
          <div class="flex gap-2"><dt class="text-maintext font-medium shrink-0">Outcome:</dt><dd class="text-subtext">{project.outcome}</dd></div>
        </dl>
      </div>
    ))}
  </section>
</Layout>
