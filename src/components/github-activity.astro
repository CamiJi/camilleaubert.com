---
import { Icon } from 'astro-icon/components';
import snapshot from '../data/github-snapshot.json';

const USER = 'CamiJi';

type Contribution = { date: string; count: number; level: number };
type Repo = { name: string; url: string; description: string; pushedAt: string };

interface SnapshotShape {
  fetchedAt: string;
  totalContributions: number;
  contributions: Contribution[];
  repos: Repo[];
}

async function fetchJson(url: string, timeoutMs = 5000): Promise<unknown> {
  const res = await fetch(url, { signal: AbortSignal.timeout(timeoutMs) });
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  return res.json();
}

async function getActivity(): Promise<SnapshotShape> {
  try {
    const [contributions, repos] = await Promise.all([
      fetchJson(`https://github-contributions-api.jogruber.de/v4/${USER}?y=last`) as Promise<any>,
      fetchJson(`https://api.github.com/users/${USER}/repos?sort=pushed&per_page=3`) as Promise<any>,
    ]);
    return {
      fetchedAt: new Date().toISOString(),
      totalContributions: contributions.total?.lastYear ?? contributions.total?.last365Days ?? 0,
      contributions: contributions.contributions ?? [],
      repos: repos.map((r: any) => ({
        name: r.name,
        url: r.html_url,
        description: r.description ?? '',
        pushedAt: r.pushed_at,
      })),
    };
  } catch {
    return snapshot as SnapshotShape;
  }
}

const activity = await getActivity();

// Trie chronologique garanti : l'API live renvoie jour par jour, mais le
// snapshot de secours (fragment HTML GitHub) est groupé par jour de semaine.
// Sans tri, l'ordre visuel serait mélangé et "récent à droite" serait faux.
const contributions = [...activity.contributions].sort((a, b) =>
  a.date < b.date ? -1 : a.date > b.date ? 1 : 0,
);

const LEVEL_STYLES: Record<number, string> = {
  0: 'bg-[#16161d]',
  1: 'bg-accent/25',
  2: 'bg-accent/45',
  3: 'bg-accent/70',
  4: 'bg-accent',
};

const fmtDate = (d: string | Date) =>
  new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const fmtPushed = (d: string) => {
  const days = Math.floor((Date.now() - new Date(d).getTime()) / 86_400_000);
  if (days <= 0) return 'pushed today';
  if (days === 1) return 'pushed yesterday';
  return `pushed ${fmtDate(d)}`;
};
---

<div class="grid min-w-0 lg:grid-cols-[1.7fr_1fr] gap-6">
  <!-- Contribution graph -->
  <div class="min-w-0 bg-accent/5 border border-accent/10 rounded-2xl p-5 md:p-6">
    <div class="flex items-baseline justify-between gap-4 mb-4">
      <p class="text-maintext font-body text-sm font-medium">
        <span class="text-accent font-semibold">{activity.totalContributions}</span> contributions on GitHub
        <span class="text-subtext">· last 12 months</span>
      </p>
      <a
        href={`https://github.com/${USER}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-subtext hover:text-accent transition-colors text-xs flex items-center gap-1 shrink-0"
      >
        github.com/{USER}
        <Icon name="mdi:arrow-top-right" class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="gh-scroll overflow-x-auto pb-1 -mx-1 px-1" data-gh-scroll>
      <div
        class="gh-grid grid gap-[3px] w-min"
        style="grid-template-rows: repeat(7, 9px); grid-auto-flow: column; grid-auto-columns: 9px;"
        aria-label="GitHub contribution graph"
      >
        {contributions.map((c) => (
          <div
            data-date={c.date}
            class={`${LEVEL_STYLES[c.level] ?? LEVEL_STYLES[0]} rounded-[2px]`}
            title={c.count >= 0 ? `${c.count} contribution${c.count === 1 ? '' : 's'} on ${c.date}` : c.date}
          />
        ))}
      </div>
    </div>
    <div class="flex items-center justify-end gap-1.5 mt-3">
      <span class="text-[10px] text-subtext">Less</span>
      {Object.values(LEVEL_STYLES).map((style) => (
        <div class={`${style} w-[9px] h-[9px] rounded-[2px]`} />
      ))}
      <span class="text-[10px] text-subtext">More</span>
    </div>
  </div>

  <!-- Recent repos -->
  <div class="min-w-0 bg-accent/5 border border-accent/10 rounded-2xl p-5 md:p-6">
    <p class="text-maintext font-body text-sm font-medium mb-4">
      Recently pushed <span class="text-subtext">· live repos</span>
    </p>
    <ul class="space-y-4">
      {activity.repos.map((repo) => (
        <li>
          <a href={repo.url} target="_blank" rel="noopener noreferrer" class="group">
            <p class="text-accent font-body text-sm font-medium group-hover:underline underline-offset-4">
              {repo.name}
            </p>
            <p class="text-subtext font-body text-xs leading-snug mt-0.5 line-clamp-2">
              {repo.description || 'Private / internal work'}
            </p>
            <p class="text-subtext/70 font-body text-[10px] mt-1">{fmtPushed(repo.pushedAt)}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .gh-grid {
    margin: 0 auto;
  }
  @media (max-width: 1023px) {
    .gh-grid {
      margin: 0;
    }
  }
  /* Barre de scroll discrète (fine, piste transparente) */
  .gh-scroll {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--color-accent) 35%, transparent) transparent;
  }
  .gh-scroll::-webkit-scrollbar {
    height: 6px;
  }
  .gh-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .gh-scroll::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--color-accent) 35%, transparent);
    border-radius: 999px;
  }
  .gh-scroll::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, var(--color-accent) 60%, transparent);
  }
  /* Case du jour mise en évidence */
  .gh-scroll [data-date].gh-today {
    outline: 1px solid var(--color-accent);
    outline-offset: 1px;
  }
</style>

<script>
  (function () {
    var scroller = document.querySelector('[data-gh-scroll]');
    if (!scroller) return;
    var days = Array.prototype.slice.call(scroller.querySelectorAll('[data-date]'));
    if (!days.length) return;

    var now = new Date();
    var pad = function (n) {
      return String(n).padStart(2, '0');
    };
    var todayStr =
      now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());

    var target =
      days.filter(function (d) {
        return d.getAttribute('data-date') === todayStr;
      })[0] || null;
    if (!target) {
      var past = days
        .filter(function (d) {
          return d.getAttribute('data-date') <= todayStr;
        })
        .sort(function (a, b) {
          var da = a.getAttribute('data-date');
          var db = b.getAttribute('data-date');
          return da < db ? -1 : da > db ? 1 : 0;
        });
      target = past[past.length - 1] || days[days.length - 1];
    }

    target.classList.add('gh-today');
    target.setAttribute('aria-current', 'date');

    // Scroll instantané, juste assez pour rendre la case visible.
    // Si déjà visible (grand écran ou début d'année) : on ne touche à rien.
    requestAnimationFrame(function () {
      var sRect = scroller.getBoundingClientRect();
      var tRect = target.getBoundingClientRect();
      var tolerance = 1;
      if (tRect.left >= sRect.left - tolerance && tRect.right <= sRect.right + tolerance) return;
      var margin = 12;
      var prevBehavior = scroller.style.scrollBehavior;
      scroller.style.scrollBehavior = 'auto';
      if (tRect.right > sRect.right) {
        scroller.scrollLeft += tRect.right - sRect.right + margin;
      } else {
        scroller.scrollLeft -= sRect.left - tRect.left + margin;
      }
      scroller.style.scrollBehavior = prevBehavior;
    });
  })();
</script>
