---
import { Icon } from 'astro-icon/components';
import profile from '../data/profile.json';

const { name, role, tagline, photoUrl, socials } = profile;
---

<section id="home" class="flex flex-col items-center justify-center section-container md:pt-30 gap-1 min-h-[80vh] text-center">
  <div class="relative group mb-2 reveal-content" style="animation-delay: 100ms;">
    <div class="w-20 h-20 md:w-24 md:h-24 rounded-full border-2 border-accent overflow-hidden shadow-[0_0_50px_color-mix(in_srgb,var(--color-accent)_25%,transparent)]">
      <img
        src={photoUrl}
        alt={name}
        width="384"
        height="384"
        fetchpriority="high"
        decoding="async"
        onerror="this.onerror=null;this.src='/placeholder.jpeg';"
        class="w-full h-full object-cover scale-110"
      />
    </div>
  </div>

  <div class="reveal-content" style="animation-delay: 200ms;">
    <p class="font-body text-accent text-xs md:text-sm font-semibold uppercase tracking-[0.25em]">
      {role}
    </p>
  </div>

  <div class="px-6 sm:px-14 md:px-18 lg:px-40 max-w-360 mx-auto relative z-0 reveal-content" style="animation-delay: 300ms;">
    <h1 class="text-5xl md:text-7xl font-heading font-bold text-maintext tracking-tight">
      {name}
    </h1>
    <p
      class="mt-6 text-subtext font-body text-lg leading-relaxed max-w-3xl mx-auto"
    >
      {tagline}
    </p>
  </div>

  <div class="mt-8 mb-4 flex flex-wrap items-center justify-center gap-4 reveal-content" style="animation-delay: 400ms;">
    <a
      href="#projects"
      class="group relative inline-flex items-center justify-center px-10 py-2 border border-accent/50 bg-accent/10 rounded-full text-maintext font-body transition-all duration-300 shadow-[0_0_20px_rgba(var(--accent-rgb),0.3)] hover:scale-105"
    >
      <span class="tracking-wide text-sm md:text-base font-medium">
        View projects
      </span>
      <div class="absolute inset-0 rounded-full blur-md bg-accent/20 -z-10 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500"></div>
    </a>
    <a
      href="#contact"
      class="inline-flex items-center justify-center px-10 py-2 border border-accent/20 rounded-full text-subtext font-body text-sm md:text-base transition-all duration-300 hover:text-maintext hover:border-accent/40"
    >
      Get in touch
    </a>
  </div>

  <div class="flex gap-6 mt-4 reveal-content" style="animation-delay: 500ms;">
    {socials.filter((social) => social.url && social.url !== "#" && social.url !== "").map((social) => (
      <a
        href={social.url}
        target="_blank"
        aria-label={social.name}
        class="group relative flex flex-col items-center justify-center transition-all duration-300 hover:scale-110"
      >
        <Icon
          name={social.icon}
          class="w-8 h-8 text-maintext group-hover:text-accent transition-colors duration-300"
        />

        <span class="absolute -bottom-6 scale-0 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300 text-xs text-accent font-body">
          {social.name}
        </span>
      </a>
    ))}
  </div>
</section>


<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
