---
import { Icon } from 'astro-icon/components';
import profile from '../data/profile.json';

---

<section id="contact" class="section-container">
  <div class="container mx-auto">
    <div class="space-y-12">
      <div class="contact-header mb-16">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
            <span class="text-accent">/</span> Contact Me
          </h2>
        <p class="text-subtext font-body text-sm max-w-md">
          Feel free to reach out. I'm always open to discussing new projects and opportunities.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-center">
        {profile.socials
        .filter((social) => social.showInContact && social.url && social.url !== "#" && social.url !== "")
        .map((social) => {
          const isEmail = social.url.startsWith('mailto:');
          const EmailCard = isEmail ? 'div' : 'a';
          return (
          <EmailCard
            href={isEmail ? undefined : social.url}
            target={isEmail ? undefined : '_blank'}
            rel={isEmail ? undefined : 'noopener noreferrer'}
            class="contact-card group p-8 bg-accent/5 border border-accent/10 rounded-2xl hover:border-accent/40 hover:bg-accent/10 transition-all duration-300"
          >
            <Icon
              name={social.icon}
              class="w-10 h-10 text-accent mb-4 mx-auto group-hover:scale-110 transition-transform"
            />
            <h3 class="text-maintext font-bold mb-1">{social.name}</h3>
            <p class="text-subtext text-xs truncate px-2">
              {social.url.replace('https://', '').replace('mailto:', '').replace('wa.me/', '+')}
            </p>
            {isEmail && (
              <div class="flex items-center justify-center gap-2 mt-4">
                <a
                  href={social.url}
                  class="inline-flex items-center gap-1 rounded-full border border-accent/20 px-3 py-1 text-[11px] text-subtext hover:text-maintext hover:border-accent/40 transition-all"
                  aria-label="Write an email"
                >
                  <Icon name="mdi:email-send-outline" class="w-3.5 h-3.5" />
                  Write
                </a>
                <button
                  type="button"
                  data-copy-email={social.url.replace('mailto:', '')}
                  class="copy-email inline-flex items-center gap-1 rounded-full border border-accent/20 px-3 py-1 text-[11px] text-subtext hover:text-maintext hover:border-accent/40 transition-all"
                  aria-label="Copy email address"
                >
                  <Icon name="mdi:content-copy" class="w-3.5 h-3.5" />
                  <span class="copy-label">Copy</span>
                </button>
              </div>
            )}
          </EmailCard>
          );
        })}
      </div>

      <!-- /* FOOTER */ -->
      <div class="contact-footer pt-20 border-t border-white/5">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <p class="text-subtext text-sm font-body order-2 md:order-1">
            {profile.name} © 2026
          </p>
          <div class="flex items-center flex-wrap justify-center gap-3 text-subtext text-xs font-body order-1 md:order-2">
            <span>Built with </span>
            <div class="flex gap-4">
              <a href="https://astro.build" target="_blank" class="hover:text-accent transition-colors flex items-center gap-1.5 group">
                <Icon name="skill-icons:astro" class="w-4 h-4 group-hover:drop-shadow-[0_0_5px_var(--color-accent)]" />
                <span>Astro</span>
              </a>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  /* Hidden reveal states live in global.css under `html.js` (see note there) */

  /* Header & Footer Initial State */
  .contact-header,
  .contact-footer {
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Cards Initial State */
  .contact-card {
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Shared Revealed State */
  .contact-header.reveal,
  .contact-card.reveal,
  .contact-footer.reveal {
    opacity: 1 !important;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  import { initReveal } from '../scripts/reveal.ts';

  const init = () => initReveal([
    { selector: '.contact-header', staggerColumns: 0 },
    { selector: '.contact-card', staggerColumns: 4, staggerDelay: 150 },
    { selector: '.contact-footer', staggerColumns: 0 },
  ]);

  window.addEventListener('load', init);
  document.addEventListener('astro:after-swap', init);

  document.querySelectorAll('.copy-email').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-copy-email');
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        const label = btn.querySelector('.copy-label');
        if (label) {
          const original = label.textContent;
          label.textContent = 'Copied!';
          setTimeout(() => (label.textContent = original), 1500);
        }
      } catch { /* clipboard unavailable */ }
    });
  });
</script>