---
import { Icon } from 'astro-icon/components';
interface NavItem {
  label: string;
  href: string;
  icon: string;
}

const navItems: NavItem[] = [
  {
    label: "Home",
    href: "#home",
    icon: `mdi:home`,
  },
  {
    label: "About",
    href: "#about",
    icon: `mdi:account`,
  },
  {
    label: "Career",
    href: "#career",
    icon: `mdi:work`,
  },
  {
    label: "Projects",
    href: "#projects",
    icon: `mdi:computer`,
  },
  {
    label: "Tech",
    href: "#tech",
    icon: `mdi:code-tags`,
  },
  {
    label: "Blog",
    href: "/writing/",
    icon: `mdi:post-outline`,
  },
  {
    label: "Contact",
    href: "#contact",
    icon: `mdi:message`,
  }
];
---
<!-- Centering wrapper: flex-based, so no translate hack can break it (fixes the mobile overflow bug) -->
<div class="dock-wrap">
  <nav
    id="main-nav"
    aria-label="Primary"
    class="reveal-content"
  >
    <ul class="flex items-center md:justify-center gap-0.5 md:gap-2">
      {
        navItems.map((item) => (
          <li class="flex items-center justify-center">
            <a
              href={item.href}
              class="dock-link group"
              aria-label={item.label}
            >
              <span class="dock-icon" aria-hidden="true">
                <Icon
                  name={item.icon}
                  class="nav-icon w-4.5 h-4.5"
                />
              </span>
              <span class="dock-label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  /* Reveal whole dock when website loads */
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: 700ms;
  }
  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Wrapper owns positioning/centering — the nav itself never carries a translate,
     so hide/show transforms can't shift it sideways ever again. */
  .dock-wrap {
    position: fixed;
    inset-inline: 0;
    z-index: 30;
    display: flex;
    justify-content: center;
    pointer-events: none;
    padding-inline: 0.75rem;
    bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
  }

  nav {
    pointer-events: auto;
    width: fit-content;
    max-width: calc(100vw - 1.5rem);
    border: 1.2px solid transparent;
    border-radius: 9999px;
    /* Clip symétrique : si le contenu dépasse un jour, la pill reste centrée
       au lieu de baver à droite. */
    overflow: hidden;
    background-color: transparent;
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    will-change: transform;
    transition:
      background-color 0.4s ease,
      backdrop-filter 0.4s ease,
      border-color 0.4s ease,
      width 0.4s ease,
      transform 0.45s cubic-bezier(0.32, 0.72, 0, 1),
      opacity 0.35s ease;
  }

  nav.scrolling {
    background-color: color-mix(in srgb, var(--color-background) 72%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.45);
  }

  /* Links — 44px de haut ; largeur flexible pour tenir à 6 dès 320px.
     min-width: 0 en cascade (li + lien) pour autoriser la compression. */
  nav li {
    min-width: 0;
  }

  .dock-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 44px;
    padding-inline: 8px;
    border-radius: 9999px;
    color: var(--color-accent);
    font-size: 0.75rem;
    line-height: 1;
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }

  .dock-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .nav-icon {
    opacity: 0.55;
    transition: transform 0.3s ease, opacity 0.3s ease, filter 0.3s ease, color 0.3s ease;
  }

  /* Mobile label: collapsed by default, expands on the active item only.
     Saves room for 6 items on 360px screens. */
  .dock-label {
    max-width: 0;
    opacity: 0;
    margin-left: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: max-width 0.35s ease, opacity 0.25s ease, margin-left 0.35s ease;
  }

  .dock-link.active {
    background-color: color-mix(in srgb, var(--color-accent) 16%, transparent);
    color: var(--color-maintext);
    font-weight: 700;
  }

  .dock-link.active .dock-label {
    max-width: 4rem;
    opacity: 1;
    margin-left: 6px;
  }

  .dock-link.active .nav-icon {
    opacity: 1;
    color: var(--color-maintext);
    transform: scale(1.15);
    filter: drop-shadow(0 0 8px var(--color-maintext));
  }

  .dock-link:not(.active):hover {
    color: var(--color-maintext);
  }

  .dock-link:not(.active):hover .nav-icon {
    opacity: 1;
    transform: scale(1.05);
  }

  /* Le dock reste toujours visible (décision UX : navigation persistante,
     voir explication). La transition transform/opacity est conservée
     pour le reveal d'entrée. */

  /* Mobile: fixed-width dock with equal slots. Labels float above the active
     item, so their text can never widen the bar or push items off-screen. */
  @media (max-width: 767px) {
    .dock-wrap {
      box-sizing: border-box;
      padding-inline: 0.5rem;
    }

    nav {
      width: 100%;
      max-width: 420px;
      overflow: visible;
      background-color: color-mix(in srgb, var(--color-background) 72%, transparent);
      border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
      backdrop-filter: blur(20px) saturate(1.4);
      -webkit-backdrop-filter: blur(20px) saturate(1.4);
      box-shadow: 0 12px 40px rgb(0 0 0 / 0.35);
    }

    nav ul {
      width: 100%;
      justify-content: space-between;
      gap: 0;
    }

    nav li {
      flex: 1 1 0;
    }

    .dock-link {
      position: relative;
      width: 100%;
      padding-inline: 0;
    }

    .dock-link.active .dock-label {
      position: absolute;
      top: -2rem;
      left: 50%;
      z-index: 1;
      width: max-content;
      max-width: none;
      margin-left: 0;
      padding: 0.4rem 0.6rem;
      transform: translateX(-50%);
      overflow: visible;
      border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
      border-radius: 9999px;
      background-color: color-mix(in srgb, var(--color-background) 88%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      font-size: 0.6875rem;
      line-height: 1;
      box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
    }
  }

  /* Space so the floating dock never covers the contact section end */
  @media (max-width: 767px) {
    body {
      padding-bottom: calc(104px + env(safe-area-inset-bottom, 0px));
    }
  }

  /* Très petits écrans (< 360px) : resserre encore pour rester centré */
  @media (max-width: 359px) {
    .dock-link {
      padding-inline: 6px;
    }
    .dock-link {
      font-size: 0.6875rem;
    }
  }

  /* Desktop (≥768px) : ancienne version — barre 80 % en haut qui se
     resserre en pill glass au scroll (morph JS : 80 % → 620 px).
     Le mobile (<768px) n'est PAS touché par ce bloc. */
  @media (min-width: 768px) {
    .dock-wrap {
      top: 1.5rem;
      bottom: auto;
    }

    nav {
      width: 80%;
      overflow: visible;
    }

    .dock-icon {
      display: none;
    }

    .dock-link {
      min-width: 0;
      font-size: 1rem;
      padding: 0.65rem 1.1rem;
    }

    .dock-label {
      position: static;
      top: auto;
      left: auto;
      z-index: auto;
      width: auto;
      max-width: none;
      opacity: 1;
      margin-left: 0;
      padding: 0;
      transform: none;
      overflow: visible;
      border: 0;
      border-radius: 0;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      box-shadow: none;
      font-size: inherit;
    }

    /* Ancien état actif desktop : pas de pastille, label en gras + glow */
    .dock-link.active {
      background-color: transparent;
      transform: scale(1.08);
    }

    .dock-link.active .dock-label {
      margin-left: 0;
      text-shadow: 0 0 10px color-mix(in srgb, var(--color-maintext) 30%, transparent);
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav");
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("nav a[href^='#']")
  );

  const maxScroll = 1000;
  const isDesktop = () => window.innerWidth >= 768;
  let rafId: number | null = null;

  function setActive(hash: string) {
    navLinks.forEach((link) => {
      const isActive = link.getAttribute("href") === hash;
      link.classList.toggle("active", isActive);
      if (isActive) {
        link.setAttribute("aria-current", "true");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  function updateNav() {
    const currentScrollY = window.scrollY;

    if (currentScrollY > 0) {
      nav?.classList.add("scrolling");

      if (isDesktop() && nav) {
        // Morphing pill: shrink width while scrolling (desktop only)
        const scrollProgress = Math.min(currentScrollY / maxScroll, 1);
        const easeProgress = 1 - Math.pow(1 - scrollProgress, 4);
        const minWidth = 620;
        const maxWidth = window.innerWidth * 0.8;
        nav.style.setProperty(
          "width",
          `${Math.max(maxWidth - (maxWidth - minWidth) * easeProgress, minWidth)}px`
        );
      }
    } else {
      nav?.classList.remove("scrolling");
      // Clear the morph so the pill returns to fit-content at the top
      nav?.style.removeProperty("width");
    }

    // Dock toujours visible : pas de masquage au scroll (cf. note UX).
    // Seul l'état "scrolling" (glass intensifié) subsiste.
    rafId = null;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!rafId) {
        rafId = requestAnimationFrame(updateNav);
      }
    },
    { passive: true }
  );

  window.addEventListener("resize", () => {
    // Crossing the breakpoint must not keep a desktop inline width on mobile
    if (!isDesktop()) nav?.style.removeProperty("width");
  });

  // Smooth scrolling to a linked section + instant active feedback
  navLinks.forEach((anchor) => {
    anchor.addEventListener("click", (e) => {
      e.preventDefault();
      const href = anchor.getAttribute("href") || "";
      const targetElement = document.getElementById(href.substring(1));
      if (targetElement) {
        setActive(href);
        targetElement.scrollIntoView({ behavior: "smooth" });
      }
    });
  });

  // Highlight the section crossing the middle band of the viewport,
  // so exactly one dock item is active at a time.
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section[id]");
    if (!sections.length) return;

    // Default state before any intersection fires
    if (!document.querySelector("nav a.active")) setActive("#home");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActive(`#${entry.target.getAttribute("id")}`);
          }
        });
      },
      { rootMargin: "-45% 0px -50% 0px", threshold: 0 }
    );
    sections.forEach((section) => observer.observe(section));
  });
</script>
