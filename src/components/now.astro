---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import nowData from '../data/now.json';
import GithubActivity from './github-activity.astro';
import profile from '../data/profile.json';

const { eyebrow, heading, bullets } = nowData;

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<section id="now" class="section-container max-w-3xl mx-auto">
  <div class="now-header reveal-content">
    <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
      <span class="text-accent">/</span> {eyebrow}
    </h2>
    <p class="text-subtext font-body text-sm max-w-md pb-8">
      {heading}
    </p>
  </div>

  <ul class="space-y-4 mb-12">
    {bullets.map((bullet, index) => (
      <li class="flex gap-3 now-item reveal-content" style={`animation-delay: ${200 + index * 120}ms;`}>
        <span class="text-accent mt-1 shrink-0">
          <Icon name="mdi:arrow-right" class="w-4 h-4" />
        </span>
        <p class="text-subtext font-body leading-relaxed">{bullet}</p>
      </li>
    ))}
  </ul>

  <div class="mb-12 now-item">
    <p class="text-maintext font-body text-sm font-semibold uppercase tracking-[0.2em] text-subtext mb-4">
      GitHub activity
    </p>
    <GithubActivity />
  </div>

  <div class="now-item">
    <div class="flex items-baseline justify-between gap-4 mb-4">
      <p class="text-maintext font-body text-sm font-semibold uppercase tracking-[0.2em] text-subtext">
        Latest writing
      </p>
      <a href="/writing/" class="text-accent hover:text-maintext transition-colors text-xs flex items-center gap-1 shrink-0">
        All posts
        <Icon name="mdi:arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="space-y-4">
      {posts.map((post) => (
        <a
          href={`/writing/${post.id}/`}
          class="group block bg-accent/5 border border-accent/10 rounded-2xl p-5 md:p-6 hover:border-accent/40 hover:bg-accent/10 transition-all"
        >
          <div class="flex items-center gap-3 mb-3">
            <img
              src={profile.photoUrl}
              alt=""
              width="384"
              height="384"
              loading="lazy"
              decoding="async"
              class="w-9 h-9 rounded-full object-cover"
            />
            <div class="text-left">
              <p class="text-maintext font-body text-sm font-medium leading-tight">{profile.name}</p>
              <p class="text-subtext font-body text-xs leading-tight">
                {fmtDate(post.data.date)} <span class="text-subtext/60">· Writing</span>
              </p>
            </div>
          </div>
          <h3 class="text-maintext font-heading font-bold text-lg text-left group-hover:text-accent transition-colors">
            {post.data.title}
          </h3>
          <p class="text-subtext font-body text-sm leading-relaxed mt-2 text-left">
            {post.data.excerpt}
          </p>
          <p class="text-accent font-body text-xs mt-4 flex items-center gap-1.5">
            Read the post
            <Icon name="mdi:arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
          </p>
        </a>
      ))}
      {posts.length === 0 && (
        <p class="text-subtext font-body text-sm">First field notes coming soon.</p>
      )}
    </div>
  </div>
</section>
