---
import { Icon } from 'astro-icon/components';
import localTechData from '../data/tech.json';

interface Skill {
  name: string;
  icon: string;
}

interface Category {
  title: string;
  skills: Skill[];
}

const categories = localTechData.categories as Category[];
---

<section id="tech" class="section-container overflow-hidden">
  <div class="container mx-auto">
    <div class="tech-header flex flex-col gap-6 mb-16">
      <div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
          <span class="text-accent">/</span> Tech Stack
        </h2>
        <p class="text-subtext font-body text-sm max-w-md">
          The tools and practices I work with, by domain
        </p>
      </div>
    </div>

    <div class="space-y-10">
      {categories.map((category) => (
        <div class="space-y-3">
          <h3 class="text-maintext font-body text-[11px] uppercase tracking-[0.4em] ml-1">
            {category.title}
          </h3>
          
          <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-7 gap-5 sm:gap-8">
            {category.skills.map((skill) => (
              /* 'skill-card' class maintains reveal animation (hidden state is .js-scoped in CSS) */
              <div class="skill-card group relative flex items-stretch min-h-14 rounded-xl bg-accent/5 border border-accent/15 hover:border-accent/40 hover:bg-accent/10 transition-all duration-300">
                
                <div class="shrink-0 w-12 flex items-center justify-center rounded-l-xl bg-accent/15 transition-colors group-hover:bg-accent/20">
                  <Icon name={skill.icon} class="w-7 h-7 group-hover:scale-110 transition-transform" />
                </div>
                
                <div class="flex items-center px-3 py-2 overflow-hidden w-full">
                  <span class="font-body text-maintext/90 text-[13px] leading-tight font-medium tracking-tight line-clamp-2">
                    {skill.name}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Hidden reveal states live in global.css under `html.js` (see note there) */

  /* Header Initial State */
  .tech-header {
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Initial state of the card */
  .skill-card {
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Shared Revealed state */
  .tech-header.reveal,
  .skill-card.reveal {
    opacity: 1 !important;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  import { initReveal } from '../scripts/reveal.ts';

  initReveal([
    { selector: '.tech-header', staggerColumns: 0 },
    { selector: '.skill-card', staggerColumns: 6, staggerDelay: 50, threshold: 0.1, rootMargin: '0px 0px -50px 0px' },
  ]);

  document.addEventListener('astro:after-swap', () => {
    initReveal([
      { selector: '.tech-header', staggerColumns: 0 },
      { selector: '.skill-card', staggerColumns: 6, staggerDelay: 50, threshold: 0.1, rootMargin: '0px 0px -50px 0px' },
    ]);
  });
</script>